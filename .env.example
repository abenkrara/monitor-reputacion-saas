# Entorno y Servidor API
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/reviews.db

# Configuración del Negocio Local
BUSINESS_NAME=Restaurante Parrilla Los Olivos
BUSINESS_PLACE_ID=ChIJN1t_tDeuEmsRUsoyG83frY4
GOOGLE_PLACES_API_KEY=

# Proveedor de Inteligencia Artificial ("groq" o "openai")
AI_PROVIDER=groq

# Credenciales Groq (Llama-3.3-70b-versatile o similar)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Credenciales OpenAI (Alternativa: gpt-4o-mini o gpt-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Notificaciones por Telegram Bot
# Crea un bot con @BotFather y obtén tu Chat ID con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Umbral de alerta (resenas con estrellas <= este valor activan alerta)
ALERT_ON_STARS_LEQ=2

# Notificaciones por Email (Opcional - SMTP)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_RECIPIENT=

